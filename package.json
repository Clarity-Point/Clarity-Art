{
  "name": "tochka-yasnosti-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run dev -w backend & npm run dev -w frontend & wait",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "node scripts/audit.mjs --level=high",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test scripts/audit.test.mjs && npm test --workspaces --if-present",
    "test:browser": "playwright test",
    "type-check": "npm exec -w backend tsc -- --noEmit && npm run type-check -w frontend",
    "check": "npm run lint && npm run format:check && npm run type-check && npm test && npm run build && npm run audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "typescript": "5.9.3",
    "axios": "^1.20.0",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.8",
    "fast-copy": "^4.1.2",
    "ip-address": "^10.7.3",
    "markdown-it": "^14.3.1",
    "shell-quote": "^1.12.0",
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
