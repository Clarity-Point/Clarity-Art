# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Prisma generated client
backend/generated/
backend/src/generated/

# Environment variables (never commit real secrets — keep .env.example only)
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Stray compiled output that must never sit beside TS sources
backend/src/**/*.js
backend/src/**/*.js.map

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Misc
*.local
.cache/
