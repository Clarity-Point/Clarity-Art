# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Matches the defaults of docker-compose.dev.yml,
# which publishes the database on host port 5433.
DATABASE_URL="postgresql://clarity:password@localhost:5433/clarity?schema=public"

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED. The server refuses to start without a strong, non-placeholder value.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# ── AI provider (OpenAI-compatible: fully local or hosted) ───────────────────
# Chat, image analysis, tagging and crisis detection use the OpenAI-compatible
# /chat/completions protocol, so you can point them at ANY such endpoint — no
# vendor lock-in. With nothing configured, the app still runs and AI features
# fall back to calm, canned responses (zero-config, offline-friendly).
#
# Fully local example (Ollama — no API key required):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.1
#   AI_VISION_MODEL=llava
#
# Hosted example (OpenRouter):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openai/gpt-4o-mini
#   AI_API_KEY=sk-or-...
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3100
NODE_ENV=development

# URL of the frontend, used for CORS.
FRONTEND_URL="http://localhost:5173"

# Number of reverse proxies in front of the app. Required for correct client IPs
# in rate limiting and access logs; set to 0 when exposed directly.
TRUST_PROXY=1

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL   trace | debug | info | warn | error | fatal | silent
#             Defaults: debug in development, info in production, silent in tests.
# LOG_FORMAT  pretty | json
#             `pretty` is colourised and human-readable (development default).
#             `json` emits one structured object per line for log shippers
#             (production default). Credentials and auth headers are redacted
#             in both modes.
LOG_LEVEL=
LOG_FORMAT=

# Set to `local` for an on-premise AI endpoint. Any external AI provider requires
# an approved, explicit provider-specific consent flow before it may receive user content.
AI_DATA_PROCESSING_MODE=local
