# Configuration for the Docker Compose stack (docker-compose.yml / docker-compose.dev.yml).
# Copy to .env and fill in. Never commit the resulting .env — it is git-ignored.
#
# For running the backend directly on the host (no Docker), see backend/.env.example.

# ── Required ────────────────────────────────────────────────────────────────
# Signing key for auth tokens. The backend refuses to start with a placeholder.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Database password. Required by the production stack; the dev stack falls back
# to `password` if unset.
POSTGRES_PASSWORD=

# ── Database (optional) ─────────────────────────────────────────────────────
POSTGRES_USER=clarity
POSTGRES_DB=clarity

# ── Networking (optional) ───────────────────────────────────────────────────
# Host port the app is served on in production.
HTTP_PORT=80
# Public origin of the frontend, used for CORS.
FRONTEND_URL=http://localhost
# Set true only when the public frontend is served over HTTPS.
COOKIE_SECURE=false

# Dev-stack host ports.
BACKEND_PORT=3100
FRONTEND_PORT=5173
POSTGRES_PORT=5433

# ── Logging (optional) ──────────────────────────────────────────────────────
# LOG_FORMAT  pretty | json    (prod defaults to json, dev to pretty)
# LOG_LEVEL   trace | debug | info | warn | error | fatal | silent
LOG_FORMAT=
LOG_LEVEL=

# ── Images (optional) ───────────────────────────────────────────────────────
# Pin a specific release instead of tracking :latest, e.g. ...-backend:v1.0.0
BACKEND_IMAGE=ghcr.io/clarity-point/clarity-art-backend:latest
FRONTEND_IMAGE=ghcr.io/clarity-point/clarity-art-frontend:latest

# ── AI provider (optional, OpenAI-compatible) ───────────────────────────────
# Any server speaking /chat/completions works — including a fully local one.
# With nothing set, AI features degrade to calm canned responses.
#
#   Local (Ollama):   AI_BASE_URL=http://host.docker.internal:11434/v1
#                     AI_MODEL=llama3.1
#                     AI_VISION_MODEL=llava
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
AI_API_KEY=
# `external` requires explicit user consent; use `local` only for on-premise AI.
AI_DATA_PROCESSING_MODE=external
